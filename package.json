{
  "name": "@ninoseki/eslint-plugin-neverthrow",
  "version": "0.0.0",
  "description": "ESLint plugin for neverthrow",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "neverthrow"
  ],
  "homepage": "https://github.com/ninoseki/eslint-plugin-neverthrow",
  "bugs": {
    "url": "https://github.com/ninoseki/eslint-plugin-neverthrow/issues"
  },
  "license": "MIT",
  "author": "Manabu Niseki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninoseki/eslint-plugin-neverthrow.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/ tests/",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.67.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@typescript-eslint/rule-tester": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-oxlint": "^1.79.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "17.3.0",
    "neverthrow": "^8.2.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "publint": "^0.3.24",
    "ts-api-utils": "^2.5.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8.0.0",
    "eslint": ">=10.0.3",
    "typescript": ">=4.8.4"
  },
  "lint-staged": {
    "*.ts": [
      "npx oxlint --fix",
      "npx oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}

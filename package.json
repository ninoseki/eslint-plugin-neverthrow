{
  "name": "@ninoseki/eslint-plugin-neverthrow",
  "version": "0.0.0",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "neverthrow"
  ],
  "homepage": "https://github.com/ninoseki/eslint-plugin-neverthrow",
  "bugs": {
    "url": "https://github.com/ninoseki/eslint-plugin-neverthrow/issues"
  },
  "license": "MIT",
  "author": "Manabu Niseki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninoseki/eslint-plugin-neverthrow.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/ tests/",
    "test": "vitest",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "tsutils": "^3.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@typescript-eslint/rule-tester": "^8.57.0",
    "@vitest/eslint-plugin": "^1.6.12",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.55.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "16.3.4",
    "neverthrow": "^8.2.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.2",
    "tsx": "^4.21.0",
    "typedoc": "0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "eslint": ">=10.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "npx oxlint --fix",
      "npx oxfmt"
    ]
  }
}
